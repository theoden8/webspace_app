<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <application>
        <!-- Debug builds only (this manifest is not merged into any release
             build), so the adb lifecycle tier can run one background refresh
             on demand. Exported because `am broadcast` reaches it from the
             shell uid; see NotificationRefreshDebugReceiver for why the
             periodic job cannot be forced instead. -->
        <receiver
            android:name=".NotificationRefreshDebugReceiver"
            android:exported="true"/>
    </application>
</manifest>
