# iOS Fastfile
# This file contains the fastlane.tools configuration for iOS

opt_out_usage

default_platform(:ios)

platform :ios do
  # Helper to get consistent paths regardless of where fastlane is run from
  # This Fastfile is always at ios/fastlane/Fastfile
  def ios_dir
    File.expand_path("..", __dir__)
  end

  def project_root
    File.expand_path("../..", __dir__)
  end

  # ITSAppUsesNonExemptEncryption without its matching
  # ITSEncryptionExportComplianceCode archives and exports cleanly and is
  # rejected only by App Store Connect at upload (ITMS-90592). Fail before the
  # binary is sent rather than after. See TOR-010.
  def check_export_compliance
    sh("cd '#{project_root}' && ./scripts/check_export_compliance.sh")
  end

  desc "Run tests"
  lane :test do
    run_tests(
      workspace: File.join(ios_dir, "Runner.xcworkspace"),
      scheme: "Runner"
    )
  end

  desc "Build debug version"
  lane :build_debug do
    sh("cd '#{project_root}' && fvm flutter build ios --debug")
  end

  desc "Build release version"
  lane :build_release do
    sh("cd '#{project_root}' && fvm flutter build ipa --release")
  end

  desc "Build iOS app (alias for build_release)"
  lane :build_ios do
    build_release
  end

  desc "Build for Ad Hoc distribution"
  lane :build_adhoc do
    sh("cd '#{project_root}' && fvm flutter build ipa --release --export-method ad-hoc")
  end

  desc "Update code signing and provisioning profiles"
  lane :sync_certificates do
    match(
      type: "appstore",
      readonly: true
    )
  end

  desc "Deploy to TestFlight"
  lane :deploy_beta do
    check_export_compliance
    build_release
    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end

  desc "Deploy to App Store"
  lane :deploy_production do
    check_export_compliance
    build_release
    upload_to_app_store(
      submit_for_review: false,
      automatic_release: false,
      skip_screenshots: true,
      skip_metadata: false
    )
  end

  desc "Deploy iOS app (alias for deploy_beta)"
  lane :deploy_ios do
    deploy_beta
  end

  desc "Update metadata only on App Store"
  lane :update_metadata do
    upload_to_app_store(
      skip_binary_upload: true,
      skip_screenshots: true
    )
  end

  desc "Increment build number"
  lane :bump_build do
    increment_build_number(
      xcodeproj: File.join(ios_dir, "Runner.xcodeproj")
    )
  end

  desc "Increment version number"
  lane :bump_version do |options|
    increment_version_number(
      xcodeproj: File.join(ios_dir, "Runner.xcodeproj"),
      bump_type: options[:type] || "patch" # major, minor, or patch
    )
  end

  # A store set, by the device it is taken on: its folder, which shares the
  # frameit config in screenshots/ios/ (frameit reads Framefile.json and
  # title.strings from a screenshot's parent folder too), and the portrait
  # size App Store Connect takes and frameit has a bezel for. A landscape
  # shot gets the same size turned.
  #
  # full_screen: the test locks an iPad to landscape, and iPadOS honours an
  # app's orientation lock only when it opts out of multitasking, so that
  # set is taken from a build that does (UIRequiresFullScreen). The shipped
  # app keeps multitasking; the lane puts Info.plist back.
  def screenshot_set(options)
    sets = {
      "iphone" => { family: "iPhone", portrait: [1170, 2532], full_screen: false }, # iPhone 13 Pro
      "ipad" => { family: "iPad", portrait: [2048, 2732], full_screen: true }, # iPad Pro 12.9"
    }
    name = (options[:device] || "iphone").to_s
    set = sets[name] || UI.user_error!("device:#{name} is not one of #{sets.keys.join(', ')}")
    set.merge(name: name, dir: File.join(project_root, "screenshots", "ios", name))
  end

  desc "Generate screenshots using Flutter integration test (device:iphone or device:ipad; udid:<simulator>, else the first one of that kind)"
  lane :screenshots do |options|
    set = screenshot_set(options)
    UI.message("Generating #{set[:name]} screenshots with Flutter integration test...")
    UI.message("Project root: #{project_root}")

    device_id = options[:udid].to_s
    if device_id.empty?
      # Padded columns name, id, platform, details, split by a bullet. The
      # platform keeps out the Mac `flutter devices` lists as "Mac Designed
      # for iPad".
      device = sh("fvm flutter devices", log: false).lines
        .map { |l| l.split("\u2022").map(&:strip) }
        .find { |name, _id, platform| platform == "ios" && name.include?(set[:family]) }
      UI.user_error!("No #{set[:family]} simulator or device found. Start one or pass udid:.") unless device
      device_id = device[1]
    end

    UI.success("Found #{set[:family]} device: #{device_id}")
    UI.message("Demo data will be seeded by Flutter integration test")

    screenshots_dir = set[:dir]
    FileUtils.mkdir_p(screenshots_dir)
    FileUtils.rm_f(Dir.glob(File.join(screenshots_dir, "*.png")))

    # Clean previous build to avoid running a stale cached version on the simulator.
    # flutter drive does an incremental build which can reuse an old installed app.
    UI.message("Cleaning previous build...")
    sh("cd '#{project_root}' && fvm flutter clean && fvm flutter pub get")

    info_plist = File.join(project_root, "ios", "Runner", "Info.plist")
    shipped_plist = File.read(info_plist)
    begin
      sh("plutil -replace UIRequiresFullScreen -bool YES '#{info_plist}'") if set[:full_screen]
      # Run Flutter integration test with screenshot capture
      # SCREENSHOT_DIR is passed to the test driver to specify where to save screenshots
      sh("cd '#{project_root}' && SCREENSHOT_DIR='#{screenshots_dir}' fvm flutter drive \
        --driver=test_driver/integration_test.dart \
        --target=integration_test/screenshot_test.dart \
        -d #{device_id}")
    ensure
      File.write(info_plist, shipped_plist)
    end

    UI.success("Screenshots saved to: #{screenshots_dir}")
  end

  desc "Resize screenshots to the set's App Store size (device:iphone or device:ipad)"
  lane :resize_screenshots do |options|
    set = screenshot_set(options)
    portrait_w, portrait_h = set[:portrait]

    Dir.glob(File.join(set[:dir], "*.png")).each do |screenshot|
      next if screenshot.end_with?("_framed.png")

      width, height = `magick identify -format '%wx%h' '#{screenshot}'`.strip.split('x').map(&:to_i)
      size = width > height ? "#{portrait_h}x#{portrait_w}" : "#{portrait_w}x#{portrait_h}"
      UI.message("Resizing #{File.basename(screenshot)} to #{size}...")
      sh("magick '#{screenshot}' -resize #{size}! '#{screenshot}'")
    end

    UI.success("#{set[:name]} screenshots resized")
  end

  desc "Frame screenshots with device frames and marketing titles (device:iphone or device:ipad)"
  lane :add_device_frames do |options|
    set = screenshot_set(options)
    screenshots_dir = set[:dir]
    output_dir = File.join(project_root, "fastlane", "screenshots", "en-US")

    # Download font if not present
    font_path = File.join(project_root, "screenshots", "Righteous-Regular.ttf")
    unless File.exist?(font_path)
      UI.message("Downloading Righteous font...")
      sh("curl -L 'https://github.com/google/fonts/raw/main/ofl/righteous/Righteous-Regular.ttf' -o '#{font_path}'")
    end

    UI.message("Removing old framed screenshots...")
    FileUtils.rm_f(Dir.glob(File.join(screenshots_dir, "*_framed.png")))

    resize_screenshots(device: set[:name])

    frame_screenshots(
      path: screenshots_dir,
      white: true
    )

    # frameit logs a shot it could not frame and carries on, as it did for
    # every shot under ImageMagick 7.1.2-33, whose mogrify could not write.
    unframed = Dir.glob(File.join(screenshots_dir, "*.png"))
      .reject { |shot| shot.end_with?("_framed.png") || File.exist?(shot.sub(/\.png\z/, "_framed.png")) }
    UI.user_error!("frameit left unframed: #{unframed.map { |shot| File.basename(shot) }.join(', ')}") unless unframed.empty?

    # Copy framed screenshots to the store metadata directory, named by the
    # set so an iPhone and an iPad shot of one screen do not overwrite each other
    FileUtils.mkdir_p(output_dir)
    Dir.glob(File.join(screenshots_dir, "*_framed.png")).each do |framed|
      output_name = "#{set[:name]}-#{File.basename(framed).gsub('_framed', '')}"
      FileUtils.cp(framed, File.join(output_dir, output_name))
      UI.message("Copied #{output_name} to #{output_dir}")
    end

    UI.success("Framed screenshots copied to: #{output_dir}")
  end

  desc "Generate and frame screenshots in one step (device:iphone or device:ipad)"
  lane :screenshots_framed do |options|
    screenshots(options)
    add_device_frames(options)
  end

  desc "Clean build artifacts"
  lane :clean do
    clear_derived_data
  end
end
