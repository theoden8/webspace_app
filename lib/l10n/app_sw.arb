  "externalTorControlAddressLabel": "Njia ya soketi au host:port",
  "externalTorControlPasswordLabel": "Nywila (si lazima)",
  "externalTorControlFormat": "Weka njia ya soketi inayoanza na /, au host:port",
  "externalTorPostureSame": "Utengaji sawa na wa Tor iliyojengewa ndani",
  "externalTorGapSharedCircuits": "Tovuti zinashiriki saketi",
  "externalTorGapSharedCircuitsHint": "SocksPort ya tor hiyo inasema NoIsolateSOCKSAuth, kwa hivyo jina la mtumiaji na nywila ambayo kila tovuti hutuma haviiweki kwenye saketi zake yenyewe, na tovuti mbili zinaweza kuhusishwa kupitia njia ya kutokea zinakotoka. Ondoa NoIsolateSOCKSAuth kwenye mstari huo wa SocksPort.",
  "externalTorGapPerHost": "Saketi moja kwa kila mwenyeji",
  "externalTorGapPerHostHint": "SocksPort ya tor hiyo inasema IsolateDestAddr, kwa hivyo tovuti hupata saketi tofauti kwa kila mwenyeji inayemfikia, ilhali Tor iliyojengewa ndani hutumia saketi moja kwa kila tovuti. Ukurasa unaopakia kutoka kwa wenyeji kadhaa hufika kupitia njia kadhaa za kutokea, na kuingia kunakokagua anwani yako kwa wenyeji tofauti kunaweza kushindwa.",
  "externalTorGapPerPort": "Saketi moja kwa kila mlango",
  "externalTorGapPerPortHint": "SocksPort ya tor hiyo inasema IsolateDestPort, kwa hivyo tovuti hupata saketi tofauti kwa kila mlango inaoufikia, ilhali Tor iliyojengewa ndani hutumia saketi moja kwa kila tovuti.",
  "externalTorGapOwnExits": "Tor hiyo huchagua njia za kutokea yenyewe: {nodes}",
  "externalTorGapOwnExitsHint": "ExitNodes ya tor hiyo yenyewe imewekwa, kwa hivyo kila tovuti isiyo na nchi yake ya kutokea hutoka kupitia nodi hizo badala ya nchi yoyote. Ikiwa programu ilifungwa wakati nchi ya kutokea ya tovuti ilikuwa ikitumika, kupakia upya mipangilio ya tor hiyo hurudisha mpangilio wake yenyewe.",
  "externalTorGapLogs": "Tor hiyo huandika anwani kwenye kumbukumbu",
  "externalTorGapLogsHint": "SafeLogging ya tor hiyo si 1, kwa hivyo kumbukumbu zake zinaweza kutaja wenyeji ambao tovuti zako hufikia. Tor iliyojengewa ndani huwaacha nje ya kumbukumbu zake.",
  "externalTorGapUnknownFlags": "Utengaji haujulikani",
