iptproxy.patch: what go/iptproxy/build.sh changes in the sources it fetches,
applied with patch -p1 in the tree it prepares, after it deletes lyrebird's
internal/x25519ell2 and transports/meeklite (LICENSE-001). Each file keeps
its own licence: IPtProxy's MIT, lyrebird's BSD-2-Clause.

* lyrebird/common/ntor/ntor.go: obfs4's handshake takes its Elligator 2 key
  hiding from go/hiddenkey.
* lyrebird/transports/transports.go, IPtProxy.go/controller.go: no meek_lite.
* IPtProxy.go/go.mod: lyrebird at its tag and hiddenkey, from the trees beside it.

--- a/IPtProxy.go/controller.go
+++ b/IPtProxy.go/controller.go
@@ -98,9 +98,6 @@
 	// Obfs4 - Transport implemented in Lyrebird.
 	Obfs4 = "obfs4"
 
-	// MeekLite - Transport implemented in Lyrebird.
-	MeekLite = "meek_lite"
-
 	// Webtunnel - Transport implemented in Lyrebird.
 	Webtunnel = "webtunnel"
 
--- a/IPtProxy.go/go.mod
+++ b/IPtProxy.go/go.mod
@@ -6,11 +6,16 @@
 
 replace www.bamsoftware.com/git/dnstt.git => ../dnstt
 
+replace gitlab.torproject.org/tpo/anti-censorship/pluggable-transports/lyrebird => ../lyrebird
+
+replace webspace.local/hiddenkey => ../hiddenkey
+
 require (
 	gitlab.torproject.org/tpo/anti-censorship/pluggable-transports/goptlib v1.6.0
-	gitlab.torproject.org/tpo/anti-censorship/pluggable-transports/lyrebird v0.0.0-20260312101154-fc105a03c0e0
+	gitlab.torproject.org/tpo/anti-censorship/pluggable-transports/lyrebird v0.0.0-20260115133752-0b10edbb61e0
 	gitlab.torproject.org/tpo/anti-censorship/pluggable-transports/snowflake/v2 v2.14.1
 	golang.org/x/net v0.56.0
+	webspace.local/hiddenkey v0.0.0-00010101000000-000000000000
 	www.bamsoftware.com/git/dnstt.git v1.20260501.0
 )
 
--- a/lyrebird/common/ntor/ntor.go
+++ b/lyrebird/common/ntor/ntor.go
@@ -48,7 +48,7 @@
 	"golang.org/x/crypto/hkdf"
 
