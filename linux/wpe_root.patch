@@ -29,6 +29,7 @@
 
 #include <glib.h>
 #include <wtf/FileSystem.h>
+#include <wtf/glib/GUniquePtr.h>
 
 namespace WebKit {
 
@@ -42,6 +43,17 @@ static String getExecutablePath()
 }
 #endif
 
+// WebSpace: a WebKit moved whole, its /usr tree under another directory (the
+// AppImage), names that directory in WEBSPACE_WPE_ROOT.
+static String executableDirectory()
+{
+    const char* root = g_getenv("WEBSPACE_WPE_ROOT");
+    if (!root || !*root)
+        return FileSystem::stringFromFileSystemRepresentation(PKGLIBEXECDIR);
+    GUniquePtr<char> moved(g_strconcat(root, PKGLIBEXECDIR, nullptr));
+    return FileSystem::stringFromFileSystemRepresentation(moved.get());
+}
+
 static String findWebKitProcess(const ASCIILiteral processName)
 {
 #if ENABLE(DEVELOPER_MODE)
@@ -60,7 +72,7 @@ static String findWebKitProcess(const ASCIILiteral processName)
     }
 #endif
 
-    return FileSystem::pathByAppendingComponent(FileSystem::stringFromFileSystemRepresentation(PKGLIBEXECDIR), processName);
+    return FileSystem::pathByAppendingComponent(executableDirectory(), processName);
 }
 
